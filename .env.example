# ════════════════════════════════════════
# PLATINIUM BOT — Environment Variables
# Copy this file to .env and fill in values
# ════════════════════════════════════════

# ── TELEGRAM (REQUIRED) ─────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: comma-separated admin user IDs
# ADMIN_IDS=123456789,987654321

# ── BITGET EXECUTION ────────────────────
# Get from bitget.com → API Management
# Permissions needed: Read + Futures Trade (NO Withdraw)
# Key type: System generated (HMAC)
BITGET_API_KEY=your_bitget_api_key
BITGET_API_SECRET=your_bitget_api_secret
BITGET_PASSPHRASE=your_bitget_passphrase

# PAPER_MODE=true  → trades are simulated (safe default)
# PAPER_MODE=false → real money on Bitget futures
PAPER_MODE=true

# USDT to risk per trade (e.g. 1 = $1 per position)
TRADE_CAPITAL_USDT=1

# ── ALERT THRESHOLDS ────────────────────
MIN_CONFIDENCE=62          # Only alert when signal confidence >= this
MIN_ACCURACY=60            # Only alert when pattern accuracy >= this
EQUITY_ALERT_PCT=5         # Alert every X% sim balance change

# ── INTERVALS (seconds) ─────────────────
TICK_INTERVAL=30           # Engine tick every 30s
PRICE_INTERVAL=15          # Fetch live BTC price every 15s
POLYMARKET_INTERVAL=300    # Fetch Polymarket sentiment every 5m

# ── SCHEDULE ────────────────────────────
DAILY_HOUR=8               # Daily summary at 08:00 UTC
